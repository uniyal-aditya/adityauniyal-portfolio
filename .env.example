# ── Supabase (client) ─────────────────────────────────────────
# Project Settings → API. These are PUBLIC values — safe to ship.
# The service-role key NEVER goes here (or anywhere client-side).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Netlify functions read these from Netlify env (not this file):
#   SUPABASE_URL, SUPABASE_ANON_KEY   → sitemap / RSS
#   SENDGRID_API_KEY, TO_EMAIL        → sendFeedback

# Canonical site origin (used for SEO tags, sitemap, RSS). Optional —
# defaults to https://adityauniyal.is-a.dev
# VITE_SITE_URL=https://your-custom-domain.com

# ── GitHub (server, AU_ / BUILDING) ──────────────────────────
# Read by the /api/github Vercel route. GITHUB_USERNAME is public;
# GITHUB_TOKEN is a classic PAT with NO scopes (public data only) —
# it exists purely to raise the API rate limit. Server-side ONLY:
# never prefix with VITE_, never import into client code.
GITHUB_USERNAME=uniyal-aditya
GITHUB_TOKEN=

# ── EmailJS (client, /connect + /feedback forms) ─────────────
# PUBLIC values — the EmailJS public key is designed to ship to the browser.
# src/lib/emailjs.ts falls back to the current production values, so these
# are optional overrides (set them only to switch service or template).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ── Seasonal ambience (self-made canvas effect) ──────────────
# Set to `off` to disable. Preview any season with ?season=winter|spring|summer|monsoon|autumn
# VITE_SEASONAL_FX=off

# ── Contact email copied by the Ctrl+K palette ("Copy contact email") ──
# Defaults to adityauniyal.dev@gmail.com — set this only if you want a different address.
# VITE_CONTACT_EMAIL=adityauniyal.dev@gmail.com

# ── Supabase Auth Send Email Hook (Vercel server-side only) ─────────
# Configure these in Vercel Project Settings → Environment Variables.
# Add to BOTH Preview and Production; never prefix these with VITE_.
# Do not commit real values to this file or Git.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
SEND_EMAIL_HOOK_SECRET=
AUTH_HOOK_SUPABASE_URL=
